# =========================================================
# Byte-compiled / optimized / DLL files
# =========================================================

__pycache__/
*.py[cod]
*$py.class

# =========================================================
# Distribution / packaging
# =========================================================

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# =========================================================
# Unit test / coverage
# =========================================================

.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# =========================================================
# Environments
# =========================================================

.env
.env.*
*.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# =========================================================
# Credentials — never in the repo, in any form
# =========================================================
# Secrets reach this project through the environment only. These patterns are a
# backstop so a stray key file cannot be staged by a wildcard add.

.git-credentials
*.pem
*.key
*_token
*_secret
credentials.json

# =========================================================
# Type checkers / linters
# =========================================================

.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# =========================================================
# Editors / OS
# =========================================================

.idea/
.vscode/
*.swp
*.swo
.DS_Store

# =========================================================
# Model weights and caches
# =========================================================
# Weights are fetched into $HF_HOME, never vendored into the repo.

*.safetensors
*.bin
*.pt
*.gguf
.hf_home/

# =========================================================
# Profiling outputs
# =========================================================

*.nsys-rep
*.ncu-rep
*.qdrep
*.sqlite

# Profiles that are deliberately published are the exception: they are evidence
# for claims made in docs/, so they are committed alongside the analysis.
!docs/profiles/*.nsys-rep
